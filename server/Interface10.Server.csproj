<Project Sdk="Microsoft.NET.Sdk">

  <!-- Interface 1.1 Backport, server part. Built here with csc @build.rsp (the same sources and references);
       this project builds it with "dotnet build -p:SptDir=<your SPT folder>" as well. The version must stay equal to
       ModMetadata.Version in Interface10Server.cs and to the client plugin's (SPT Forge's rule). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Interface10.Server</AssemblyName>
    <RootNamespace>Interface10Server</RootNamespace>
    <Version>1.0.1</Version>
    <Authors>Grifm0le</Authors>
    <Product>Interface 1.1 Backport</Product>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="SPTarkov.Common"><HintPath>$(SptDir)\SPT_Runtime\SPTarkov.Common.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SPTarkov.DI"><HintPath>$(SptDir)\SPT_Runtime\SPTarkov.DI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SPTarkov.Server.Core"><HintPath>$(SptDir)\SPT_Runtime\SPTarkov.Server.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SemanticVersioning"><HintPath>$(SptDir)\SPT_Runtime\SemanticVersioning.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(SptDir)\SPT_Runtime\0Harmony.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <Target Name="NeedSptDir" BeforeTargets="ResolveAssemblyReferences" Condition="'$(SptDir)' == ''">
    <Error Text="Give your SPT folder: dotnet build -p:SptDir=&quot;C:\path\to\SPT&quot;" />
  </Target>

</Project>
